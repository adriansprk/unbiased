# Copy to backend/.env and fill in.

# --- Required ---
PORT=3001
FRONTEND_URL=http://localhost:3000
REDIS_URL=redis://localhost:6379
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
FIRECRAWL_API_KEY=
GEMINI_API_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# --- Optional ---
# gemini (default) or openai
ANALYSIS_LLM_PROVIDER=gemini
GEMINI_MODEL_NAME=
# OpenAI fallback
OPENAI_API_KEY=
LLM_MODEL_NAME=gpt-4o
# Serve existing results for already-analyzed URLs
REUSE_EXISTING_ANALYSIS=false
# error | warn | info | debug | trace
LOG_LEVEL=
# Defaults to PORT
SOCKET_PORT=
