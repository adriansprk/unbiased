# Copy to .env.local and fill in. Variables without NEXT_PUBLIC_ stay on the server.

# --- Required ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
FIRECRAWL_API_KEY=
OPENAI_API_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=

# --- Optional ---
# Model for the analysis (default gpt-6.1-sol)
LLM_MODEL_NAME=
# Any other LLM with an OpenAI-compatible API that supports structured outputs (response_format json_schema):
# set its base URL, put its key in OPENAI_API_KEY and its model id in LLM_MODEL_NAME. For example:
#   OpenRouter  https://openrouter.ai/api/v1   (also for Claude: Anthropic's own endpoint ignores response_format)
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai/
#   Mistral     https://api.mistral.ai/v1
#   Ollama      http://localhost:11434/v1
OPENAI_BASE_URL=
# Publication logos in the hero carousel
NEXT_PUBLIC_LOGO_DEV_API_KEY=
# error | warn | info | debug | trace (server / browser)
LOG_LEVEL=
NEXT_PUBLIC_LOG_LEVEL=
